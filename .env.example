# Public URL of the site (used for sitemap, canonical links and Open Graph)
NUXT_PUBLIC_SITE_URL=https://fulcrongrv.it

# Where the gallery photos are served from
# (default: /foto if public/foto has photos, otherwise https://foto.fulcrongrv.it)
# NUXT_PUBLIC_GALLERY_URL=https://foto.fulcrongrv.it

# Where the rulebook PDFs are served from (default: https://documenti.fulcrongrv.it)
# NUXT_PUBLIC_DOCUMENTS_URL=https://documenti.fulcrongrv.it
