# Connection string for MongoDB (credentials must be URL-encoded).
# Without it the site works, but Gallery, Oneshot and Bacheca show an empty-state message.
NUXT_MONGODB_URI=mongodb://user:password@localhost:27017/fulcron?authSource=admin

# Folder that holds the photos, one sub-folder per album (e.g. gallery/alla-vecchia-spada/*.jpg)
NUXT_GALLERY_DIR=./gallery

# Public URL of the site (used for sitemap and Open Graph)
NUXT_PUBLIC_SITE_URL=https://fulcrongrv.it
