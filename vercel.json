{
  "buildCommand": "npm run generate",
  "outputDirectory": ".output/public",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "x-content-type-options": "nosniff",
        "referrer-policy": "strict-origin-when-cross-origin",
        "x-frame-options": "SAMEORIGIN",
        "permissions-policy": "camera=(), microphone=(), geolocation=()"
      },
      "continue": true
    },
    {
      "src": "/_nuxt/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/_ipx/(.*)",
      "headers": { "cache-control": "public, max-age=86400, stale-while-revalidate=604800" },
      "continue": true
    },
    {
      "src": "/documents/guida-eventi\\.pdf",
      "status": 301,
      "headers": { "location": "https://documenti.fulcrongrv.it/GuidaEventi.pdf" }
    },
    {
      "src": "/documents/manuale-abilita\\.pdf",
      "status": 301,
      "headers": { "location": "https://documenti.fulcrongrv.it/ManualeAbilita.pdf" }
    },
    {
      "src": "/documents/guida-magia\\.pdf",
      "status": 301,
      "headers": { "location": "https://documenti.fulcrongrv.it/GuidaMagia.pdf" }
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
