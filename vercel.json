{
  "buildCommand": "npm run generate",
  "outputDirectory": ".output/public",
  "routes": [
    {
      "src": "/_nuxt/(.*)",
      "headers": { "cache-control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
